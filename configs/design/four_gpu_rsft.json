{
  "schema_version": "draft-0.1",
  "status": "design-only",
  "name": "gsm8k_tool_rsft_4gpu_pilot",
  "roles": {
    "mode": "external_meta",
    "meta": {
      "provider": null,
      "model": null,
      "revision": null
    },
    "task": {
      "model": "Qwen/Qwen3-4B",
      "revision": null
    }
  },
  "seed": 42,
  "resources": {
    "gpus": 4,
    "scheduling": "phase_exclusive",
    "precision": "bf16_if_supported",
    "gpu_memory_gib": "measure_before_run",
    "cpu_tool_workers": 4
  },
  "recipe": {
    "name": "alternating",
    "phase_order": [
      "edit_harness",
      "search",
      "collect",
      "verify",
      "curate",
      "sft",
      "reload",
      "confirm",
      "select"
    ],
    "rounds": 3,
    "candidates_per_round": 2,
    "train_shortlist": 1
  },
  "snapshot": {
    "seed_harness": "react_tool_v1_to_be_implemented",
    "require_model_harness_resource_digests": true
  },
  "benchmark": {
    "name": "gsm8k_tool",
    "source_revision": null,
    "manifest": null,
    "splits": {
      "weight": 2048,
      "search": 128,
      "select": 128,
      "final": "official_test"
    },
    "dedup_before_split": true,
    "split_unit": "problem_group"
  },
  "task_sampling": {
    "training_tasks_per_round": 512,
    "training_attempts_per_task": 2,
    "search_tasks_per_candidate": 64,
    "confirmation_tasks_per_pair": 128,
    "pairs_confirmed": 2,
    "diagnostic_episodes_per_round": 64
  },
  "rollout": {
    "max_model_calls": 8,
    "max_output_tokens_per_call": 512,
    "max_output_tokens_per_episode": 2048,
    "temperature": 0.7,
    "timeout_seconds": 120,
    "record_rendered_prefix": true
  },
  "training": {
    "backend": "official_trl_peft_planned",
    "objective": "sft_on_verified_success",
    "tuning": "lora",
    "lora_rank": 16,
    "epochs": 1,
    "micro_batch_size": 1,
    "max_sequence_tokens": 4096,
    "overlong": "drop_with_reason",
    "minimum_accepted_trajectories": 64,
    "on_insufficient_data": "no_update",
    "data_mix": {
      "basis": "assistant_target_tokens",
      "current_harness_success": 1,
      "compatible_replay": 0
    },
    "optimizer_between_phases": "fresh_state_recorded"
  },
  "evaluation": {
    "training_verifier": "fixed_numeric_verifier_planned",
    "search_evaluator": "fixed_task_metric_planned",
    "final_evaluator": "frozen_task_metric_planned",
    "final_feedback_to_meta": false,
    "selection_returns": "aggregate_only",
    "promotion": {
      "minimum_absolute_gain": 0.02,
      "require_cost_cap": true,
      "on_uncertain": "retain_parent"
    }
  },
  "budget": {
    "reserve_final_evaluation": true,
    "max_total_episodes": 6500,
    "max_task_generated_tokens": 20000000,
    "max_meta_calls": 12,
    "max_meta_generated_tokens": 65536,
    "max_gpu_hours": 16,
    "max_wall_hours": 24,
    "count_retries": true,
    "unconfirmed_calls": "conservative_reservation",
    "api_dollar_cap": null
  },
  "artifacts": {
    "require_atomic_completion_manifest": true,
    "reload_checks_model_digest": true,
    "store_raw_trajectories": true,
    "store_in_git": false
  }
}
