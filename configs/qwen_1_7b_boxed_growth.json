{
  "task": {
    "model": "Qwen/Qwen3-1.7B",
    "base_url": "http://127.0.0.1:18002/v1",
    "api_key_env": "RSI_LOCAL_API_KEY",
    "max_tokens": 8192,
    "timeout": 240,
    "temperature": 0,
    "extra_body": {
      "chat_template_kwargs": {
        "enable_thinking": false
      },
      "repetition_penalty": 1.0
    },
    "user_suffix": "Give concise reasoning, and put the final numeric answer inside \\boxed{}."
  },
  "meta": {
    "model": "deepseek-v4.1-flash",
    "base_url": "https://zgc.apihy.com",
    "max_tokens": 4096,
    "timeout": 240,
    "state_dir": ".local/claude-1_7b-boxed",
    "prompt_char_budget": 600
  },
  "agent": {
    "system_prompt": "Solve the math problem carefully. Use exact reasoning and answer the requested quantity."
  },
  "limits": {
    "rounds": 8,
    "max_task_calls": 520,
    "max_meta_calls": 10,
    "task_concurrency": 16,
    "wall_seconds": 10800
  },
  "evaluator": "math_numeric"
}
